# SurakshaGrid Runtime Environment Configuration

# Application & Environment Settings
APP_NAME=SurakshaGrid
APP_ENV=development
DEBUG=false
PORT=8000

# Security & Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OFFICER_3492_PASSWORD_HASH=$2b$12$eImiTXuWVxfM37uY4JANjO5E/x.X5K9nJ7/Q0qj2uUq6a4w7M37eS

# PostGIS Spatial Database Configuration
DATABASE_URL=postgresql+asyncpg://surakshagrid:surakshagrid@localhost:5432/surakshagrid
POSTGRES_DB=surakshagrid
POSTGRES_USER=surakshagrid
POSTGRES_PASSWORD=surakshagrid
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
PGADMIN_DEFAULT_EMAIL=admin@surakshagrid.local
PGADMIN_DEFAULT_PASSWORD=admin123

# OSRM Routing Engine
OSRM_BASE_URL=http://localhost:5000
OSRM_DATASET=delhi

# Remote Sensing & Copernicus Sentinel-1 Storage Credentials
COPERNICUS_S3_ENDPOINT=https://dataspace.copernicus.eu
COPERNICUS_S3_BUCKET=sentinel-1-grd-sar
COPERNICUS_ACCESS_KEY=YOUR_COPERNICUS_ACCESS_KEY
COPERNICUS_SECRET_KEY=YOUR_COPERNICUS_SECRET_KEY

# Frontend Connection URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
