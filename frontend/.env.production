# SurakshaGrid Next.js Frontend Production Environment Configuration

# Fully Qualified Backend API URL on Render Cloud
NEXT_PUBLIC_API_URL=https://surakshagrid-api.onrender.com

# Secured WebSocket Communication URI (wss://)
NEXT_PUBLIC_WS_URL=wss://surakshagrid-api.onrender.com

# MapLibre GL Vector & Raster Tile Endpoint
NEXT_PUBLIC_MAPLIBRE_STYLE_URL=https://a.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}@2x.png
